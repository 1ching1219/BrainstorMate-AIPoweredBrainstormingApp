# Copy this file to .env and fill in your values
# Django will read these automatically if you use python-dotenv,
# or set them in your shell / Daphne launch command.

# Required for real AI responses (leave blank to use built-in template fallbacks)
OPENAI_API_KEY=sk-...

# Django secret key — change this in production
DJANGO_SECRET_KEY=django-insecure-changeme

# Set to False in production
DJANGO_DEBUG=True

# Comma-separated list of allowed hosts (add your ngrok domain here)
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app
