# Expo mobile frontend environment variables
# Copy this file to .env and adjust as needed.
# All variables must be prefixed with EXPO_PUBLIC_ to be accessible in the app.

# Backend API base URL — required for physical device / ngrok testing.
# Defaults to http://localhost:8000/api if not set.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Examples:
# EXPO_PUBLIC_API_BASE_URL=https://your-ngrok-url.ngrok-free.app/api
# EXPO_PUBLIC_API_BASE_URL=http://192.168.x.y:8000/api
