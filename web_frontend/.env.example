# React web frontend environment variables
# Copy this file to .env and adjust as needed.

# Port for the React dev server
PORT=8001

# Backend API base URL — set this to your Daphne server address.
# Defaults to http://localhost:8000/api if not set.
REACT_APP_API_BASE_URL=http://localhost:8000/api

# Examples for remote access:
# REACT_APP_API_BASE_URL=https://your-ngrok-url.ngrok-free.app/api
# REACT_APP_API_BASE_URL=http://192.168.x.y:8000/api
